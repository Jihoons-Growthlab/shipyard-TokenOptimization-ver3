{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(scripts/*)",
      "Bash(bash scripts/*)",
      "Bash(node scripts/*)",
      "Bash(python3 scripts/*)",
      "Bash(uv *)",
      "Bash(npm *)",
      "Bash(npx vite *)",
      "Bash(npx vitest *)",
      "Bash(node *)",
      "Bash(sqlite3 *)",
      "Bash(rg *)",
      "Bash(curl http://127.0.0.1*)"
    ],
    "deny": [
      "Agent",
      "WebSearch",
      "WebFetch",
      "NotebookEdit",
      "Edit(./specs/**)",
      "Edit(./reference/**)",
      "Edit(./config/**)",
      "Edit(./state/tasks.json)",
      "Edit(./state/sessions.log)",
      "Edit(./state/SOURCEMAP.md)",
      "Read(./scripts/node_modules/**)"
    ]
  },
  "enabledPlugins": {
    "ponytail@ponytail": false
  },
  "enableAllProjectMcpServers": false,
  "disableClaudeAiConnectors": true
}
